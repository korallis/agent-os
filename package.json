{
  "name": "agent-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify:no-deprecated": "node scripts/verify-no-deprecated.mjs",
    "gates": "node tooling/gates/phase-1.mjs && node tooling/gates/phase-2.mjs && node tooling/gates/phase-3.mjs && node tooling/gates/phase-4.mjs && node tooling/gates/phase-5.mjs && node tooling/gates/phase-6.mjs",
    "screenshots": "pnpm run build && node tooling/screenshots/capture-console.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "better-sqlite3": "13.0.1",
    "eslint": "9.39.4",
    "playwright": "1.62.0",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "ws": "8.21.1"
  }
}
